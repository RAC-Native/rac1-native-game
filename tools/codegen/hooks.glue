# Hook points in the levels' generated code (read by tools/codegen/mips2cpp.py via load_hooks).
#   L<n> 0xADDR: <statement>   emitted before the instruction at ADDR of level n's code, after its label
#   L<n> 0xADDR label          ADDR made a label, for a statement's `goto L_<addr>`
# A line whose function is hand-written is never placed, silently: tools/codegen/check_hooks.py fails on such a line (and
# lists where each line lands, --list). Porting a hooked function: carry the fork into the port, then drop its lines here.
#
# 0.x's hooks that left with their units in stages 1-3; the forks are in the hand-written ports (audit of 2026-11-14):
#   the levels' hero copies (L5 6 8 11 12 14 15 16 17 18: the points A-N and the PAL lines I / J of Advanced, 1.02 Gameplay
#   fixes 9 and 13), run by the Veldin ports through the variants tables: hero_state_update.cpp (A B C), hero_state.cpp
#   (D, P9f P9g, P13), hero_transitions.cpp (E F G H M N, P9a P9c P9d P9e), hero_input.cpp (L), ovl_21.cpp (I J; K inside
#   hero_stick_speed), hero_update.cpp (P9i); a level mod's board, lava and surface on Rilgar / Kalebo III: hero_hoverboard.cpp,
#   hero_update.cpp, ovl_21.cpp

# ---- The palette blend (one routine in six overlays: Kerwan 0x23c428, Rilgar 0x277b20, Umbris 0x2762e0, Batalia 0x257d40, Gaspar 0x26d240,
# Oltanis 0x255ce0): its texel loop on the host (src/game/ovl/palette_blend.h; RAC1_PERF_PALETTE_BLEND=0 the loop as transliterated), at the
# loop's setup after the two palettes' conversions. Each palette entry's weighted value made once instead of once per texel.
L3 0x0023c620: { uint32_t pb_v0 = 0; if (palette_blend_loop(a0.w(), a1.w(), a3.w(), t1.w(), &pb_v0)) return TrRet{pb_v0, fr[0]}; }  // palette blend
L5 0x00277d18: { uint32_t pb_v0 = 0; if (palette_blend_loop(a0.w(), a1.w(), a3.w(), t1.w(), &pb_v0)) return TrRet{pb_v0, fr[0]}; }  // palette blend
L7 0x002764d8: { uint32_t pb_v0 = 0; if (palette_blend_loop(a0.w(), a1.w(), a3.w(), t1.w(), &pb_v0)) return TrRet{pb_v0, fr[0]}; }  // palette blend
L8 0x00257f38: { uint32_t pb_v0 = 0; if (palette_blend_loop(a0.w(), a1.w(), a3.w(), t1.w(), &pb_v0)) return TrRet{pb_v0, fr[0]}; }  // palette blend
L9 0x0026d438: { uint32_t pb_v0 = 0; if (palette_blend_loop(a0.w(), a1.w(), a3.w(), t1.w(), &pb_v0)) return TrRet{pb_v0, fr[0]}; }  // palette blend
L14 0x00255ed8: { uint32_t pb_v0 = 0; if (palette_blend_loop(a0.w(), a1.w(), a3.w(), t1.w(), &pb_v0)) return TrRet{pb_v0, fr[0]}; }  // palette blend

# ---- 1.02 Gameplay, fix 10 (src/game/enhance/fixes102.h): the later build's (1.02: the Japanese disc, the PAL disc 2.00) guards on
# the characters that take the hero's input. A prompted character (hud_message_request(7, ...), then the triangle: Pokitaru's
# class at 0x313290, Gemlik's 69 at 0x2bb068, Drek's fleet's 1379 at 0x2ed018): the prompt not offered while the hero is in the
# state 0x32 or 0x1d or in a vehicle mode (gameplay102_talk_blocked: to the test of the press, its flag still clear), and the hero
# put in 0x32 at once when it is pressed (the 1.02 build moved that hero_set_state(0x32, 1) there from the character's next
# step, whose call is skipped). Rilgar's 918 (0x316ab8) and Kalebo III's 1455 (0x2e6808): talk_update not run while the hero is
# in 0x1d (gameplay102_talk_held: on to what follows it, a0 the moby as the 1.02 build's branch leaves it), and the hero's input
# locked (+0x20ac) as the scene starts (gameplay102_talk_lock). With the fix off each statement is a test that fails.
# The 1.02 build's points: Pokitaru 0x314b34 / 0x314c68, Gemlik 0x2bc910 / 0x2bc95c, Drek's fleet 0x2eeff4 / 0x2ef044, Rilgar
# 0x3180a8 / 0x318150, Kalebo III 0x2e7dc0 / 0x2e7f70.
L11 0x003136e8: if (gameplay102_talk_blocked()) goto L_313804;  // enhancement: 1.02 Gameplay, fix 10 (guard)
L11 0x003137fc: if (gameplay102_on(10)) hero_set_state(0x32, 1);  // enhancement: 1.02 Gameplay, fix 10 (0x32 at the press)
L11 0x00313854: if (gameplay102_on(10)) goto L_313860;  // enhancement: 1.02 Gameplay, fix 10 (the later 0x32 skipped)
L11 0x00313860 label
L13 0x002bb6a8: if (gameplay102_talk_blocked()) goto L_2bb6cc;  // enhancement: 1.02 Gameplay, fix 10 (guard)
L13 0x002bb6d4: if (gameplay102_on(10)) hero_set_state(0x32, 1);  // enhancement: 1.02 Gameplay, fix 10 (0x32 at the press)
L13 0x002bb83c: if (gameplay102_on(10)) goto L_2bb848;  // enhancement: 1.02 Gameplay, fix 10 (the later 0x32 skipped)
L13 0x002bb848 label
L17 0x002ed508: if (gameplay102_talk_blocked()) goto L_2ed524;  // enhancement: 1.02 Gameplay, fix 10 (guard)
L17 0x002ed534: if (gameplay102_on(10)) hero_set_state(0x32, 1);  // enhancement: 1.02 Gameplay, fix 10 (0x32 at the press)
L17 0x002ed6c4: if (gameplay102_on(10)) goto L_2ed6d0;  // enhancement: 1.02 Gameplay, fix 10 (the later 0x32 skipped)
L17 0x002ed6d0 label
